  <metadata>
    <id>ipatool</id>
    <version>2.6.0</version>
    <title>ipatool</title>
    <authors>Majd Alfhaily</authors>
    <owners>Smart123s</owners>
    <projectUrl>https://github.com/majd/ipatool</projectUrl>
